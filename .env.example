# Template of the environment variables the app reads (see docs/DEPLOYMENT.md).
# Copy to a real, untracked file or set them in the hosting dashboard. Never commit real values.
# .NET maps "__" to ":" in configuration keys.

ASPNETCORE_ENVIRONMENT=Production

# Database
ConnectionStrings__Database=Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<password>

# JWT (secret: at least 32 random characters, different per environment)
Jwt__Secret=
Jwt__Issuer=HarnasHub
Jwt__Audience=HarnasHub.Client
Jwt__ExpiryMinutes=43200

# Discord sign-in (RequiredGuildId restricts login to your team's server)
DiscordOAuth__ClientId=
DiscordOAuth__ClientSecret=
DiscordOAuth__RedirectUri=https://<your-host>/api/auth/discord/callback
DiscordOAuth__RequiredGuildId=

# Discord notification webhooks (fallback + optional per-channel)
Discord__WebhookUrl=
Discord__Webhooks__Announcements=
Discord__Webhooks__MatchSchedule=
Discord__Webhooks__DemoReview=
Discord__Webhooks__OpponentScouting=

# S3-compatible storage for demos and match timelines (optional)
S3__Endpoint=
S3__AccessKey=
S3__SecretKey=
S3__BucketName=

# FACEIT (optional)
Faceit__ApiKey=
Faceit__DownloadsApiToken=

Frontend__BaseUrl=https://<your-host>
